# Database Configuration
POSTGRES_DB=savdocrm
POSTGRES_USER=savdocrm_user
POSTGRES_PASSWORD=savdocrm_secret_dev
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/savdocrm

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Security & JWT Configuration
JWT_SECRET=replace_this_with_a_secure_base64_secret_key_at_least_256_bits_long
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=2592000
