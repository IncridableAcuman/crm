<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="v1.0.0-24-create-inventory-balances-and-costs" author="savdocrm-inventory">
        <comment>Create inventory_balances, inventory_warehouse_stocks (materialized projection), and inventory_costs (WAC valuation) tables</comment>

        <createTable tableName="inventory_balances">
            <column name="id" type="UUID">
                <constraints primaryKey="true" primaryKeyName="pk_inventory_balances" nullable="false"/>
            </column>
            <column name="tenant_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_inv_balances_tenant"
                             references="tenants(id)"
                             deleteCascade="false"/>
            </column>
            <column name="warehouse_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="location_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="variant_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="quantity_on_hand" type="NUMERIC(12,3)" defaultValueNumeric="0.000">
                <constraints nullable="false"/>
            </column>
            <column name="quantity_reserved" type="NUMERIC(12,3)" defaultValueNumeric="0.000">
                <constraints nullable="false"/>
            </column>
            <column name="last_movement_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="UUID"/>
            <column name="updated_by" type="UUID"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="inventory_balances"
                             columnNames="tenant_id, warehouse_id, location_id, variant_id"
                             constraintName="uq_inv_balances_key"/>

        <addForeignKeyConstraint baseTableName="inventory_balances"
                                 baseColumnNames="tenant_id, warehouse_id"
                                 constraintName="fk_inv_balances_warehouse"
                                 referencedTableName="warehouses"
                                 referencedColumnNames="tenant_id, id"
                                 onDelete="RESTRICT"/>

        <addForeignKeyConstraint baseTableName="inventory_balances"
                                 baseColumnNames="tenant_id, warehouse_id, location_id"
                                 constraintName="fk_inv_balances_location"
                                 referencedTableName="stock_locations"
                                 referencedColumnNames="tenant_id, warehouse_id, id"
                                 onDelete="RESTRICT"/>

        <addForeignKeyConstraint baseTableName="inventory_balances"
                                 baseColumnNames="tenant_id, variant_id"
                                 constraintName="fk_inv_balances_variant"
                                 referencedTableName="product_variants"
                                 referencedColumnNames="tenant_id, id"
                                 onDelete="RESTRICT"/>

        <createIndex tableName="inventory_balances" indexName="idx_inv_balances_tenant_variant">
            <column name="tenant_id"/>
            <column name="variant_id"/>
        </createIndex>

        <createIndex tableName="inventory_balances" indexName="idx_inv_balances_wh_variant">
            <column name="tenant_id"/>
            <column name="warehouse_id"/>
            <column name="variant_id"/>
        </createIndex>

        <sql dbms="postgresql">
            ALTER TABLE inventory_balances
            ADD CONSTRAINT chk_inv_balances_non_negative
            CHECK (quantity_on_hand &gt;= 0 AND quantity_reserved &gt;= 0 AND quantity_reserved &lt;= quantity_on_hand);
        </sql>

        <createTable tableName="inventory_warehouse_stocks">
            <column name="id" type="UUID">
                <constraints primaryKey="true" primaryKeyName="pk_inventory_warehouse_stocks" nullable="false"/>
            </column>
            <column name="tenant_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_inv_wh_stocks_tenant"
                             references="tenants(id)"
                             deleteCascade="false"/>
            </column>
            <column name="warehouse_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="variant_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="quantity_on_hand" type="NUMERIC(12,3)" defaultValueNumeric="0.000">
                <constraints nullable="false"/>
            </column>
            <column name="quantity_sellable" type="NUMERIC(12,3)" defaultValueNumeric="0.000">
                <constraints nullable="false"/>
            </column>
            <column name="quantity_reserved" type="NUMERIC(12,3)" defaultValueNumeric="0.000">
                <constraints nullable="false"/>
            </column>
            <column name="quantity_staging" type="NUMERIC(12,3)" defaultValueNumeric="0.000">
                <constraints nullable="false"/>
            </column>
            <column name="quantity_damaged" type="NUMERIC(12,3)" defaultValueNumeric="0.000">
                <constraints nullable="false"/>
            </column>
            <column name="quantity_quarantined" type="NUMERIC(12,3)" defaultValueNumeric="0.000">
                <constraints nullable="false"/>
            </column>
            <column name="quantity_in_transit" type="NUMERIC(12,3)" defaultValueNumeric="0.000">
                <constraints nullable="false"/>
            </column>
            <column name="reorder_point" type="NUMERIC(12,3)"/>
            <column name="last_movement_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="UUID"/>
            <column name="updated_by" type="UUID"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="inventory_warehouse_stocks"
                             columnNames="tenant_id, warehouse_id, variant_id"
                             constraintName="uq_inv_wh_stocks_key"/>

        <addForeignKeyConstraint baseTableName="inventory_warehouse_stocks"
                                 baseColumnNames="tenant_id, warehouse_id"
                                 constraintName="fk_inv_wh_stocks_warehouse"
                                 referencedTableName="warehouses"
                                 referencedColumnNames="tenant_id, id"
                                 onDelete="RESTRICT"/>

        <addForeignKeyConstraint baseTableName="inventory_warehouse_stocks"
                                 baseColumnNames="tenant_id, variant_id"
                                 constraintName="fk_inv_wh_stocks_variant"
                                 referencedTableName="product_variants"
                                 referencedColumnNames="tenant_id, id"
                                 onDelete="RESTRICT"/>

        <createIndex tableName="inventory_warehouse_stocks" indexName="idx_inv_wh_stocks_variant">
            <column name="tenant_id"/>
            <column name="variant_id"/>
        </createIndex>

        <sql dbms="postgresql">
            ALTER TABLE inventory_warehouse_stocks
            ADD COLUMN quantity_available NUMERIC(12,3)
            GENERATED ALWAYS AS (quantity_sellable - quantity_reserved) STORED;

            ALTER TABLE inventory_warehouse_stocks
            ADD CONSTRAINT chk_inv_wh_stocks_non_negative
            CHECK (
                quantity_on_hand &gt;= 0
                AND quantity_sellable &gt;= 0
                AND quantity_reserved &gt;= 0
                AND quantity_reserved &lt;= quantity_sellable
                AND quantity_staging &gt;= 0
                AND quantity_damaged &gt;= 0
                AND quantity_quarantined &gt;= 0
                AND quantity_in_transit &gt;= 0
                AND (reorder_point IS NULL OR reorder_point &gt;= 0)
            );

            ALTER TABLE inventory_warehouse_stocks
            ADD CONSTRAINT chk_inv_wh_stocks_sum
            CHECK (quantity_on_hand = quantity_sellable + quantity_staging + quantity_damaged + quantity_quarantined);

            CREATE INDEX idx_inv_wh_stocks_low_stock
            ON inventory_warehouse_stocks (tenant_id, warehouse_id)
            WHERE reorder_point IS NOT NULL AND quantity_available &lt;= reorder_point;
        </sql>

        <createTable tableName="inventory_costs">
            <column name="id" type="UUID">
                <constraints primaryKey="true" primaryKeyName="pk_inventory_costs" nullable="false"/>
            </column>
            <column name="tenant_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_inv_costs_tenant"
                             references="tenants(id)"
                             deleteCascade="false"/>
            </column>
            <column name="warehouse_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="variant_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="costing_method" type="VARCHAR(16)" defaultValue="WAC">
                <constraints nullable="false"/>
            </column>
            <column name="unit_cost" type="NUMERIC(15,4)" defaultValueNumeric="0.0000">
                <constraints nullable="false"/>
            </column>
            <column name="total_value" type="NUMERIC(18,4)" defaultValueNumeric="0.0000">
                <constraints nullable="false"/>
            </column>
            <column name="valued_quantity" type="NUMERIC(12,3)" defaultValueNumeric="0.000">
                <constraints nullable="false"/>
            </column>
            <column name="last_cost_updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="UUID"/>
            <column name="updated_by" type="UUID"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="inventory_costs"
                             columnNames="tenant_id, warehouse_id, variant_id"
                             constraintName="uq_inv_costs_key"/>

        <addForeignKeyConstraint baseTableName="inventory_costs"
                                 baseColumnNames="tenant_id, warehouse_id"
                                 constraintName="fk_inv_costs_warehouse"
                                 referencedTableName="warehouses"
                                 referencedColumnNames="tenant_id, id"
                                 onDelete="RESTRICT"/>

        <addForeignKeyConstraint baseTableName="inventory_costs"
                                 baseColumnNames="tenant_id, variant_id"
                                 constraintName="fk_inv_costs_variant"
                                 referencedTableName="product_variants"
                                 referencedColumnNames="tenant_id, id"
                                 onDelete="RESTRICT"/>

        <sql dbms="postgresql">
            ALTER TABLE inventory_costs
            ADD CONSTRAINT chk_inv_costs_method
            CHECK (costing_method = 'WAC');

            ALTER TABLE inventory_costs
            ADD CONSTRAINT chk_inv_costs_non_negative
            CHECK (unit_cost &gt;= 0 AND total_value &gt;= 0 AND valued_quantity &gt;= 0);
        </sql>

        <rollback>
            <dropTable tableName="inventory_costs"/>
            <dropTable tableName="inventory_warehouse_stocks"/>
            <dropTable tableName="inventory_balances"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
