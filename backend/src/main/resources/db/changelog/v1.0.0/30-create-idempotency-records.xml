<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="v1.0.0-30-create-idempotency-records" author="savdocrm-core">
        <comment>Create shared tenant-scoped idempotency_records table for retry-safe mutating API commands</comment>

        <createTable tableName="idempotency_records">
            <column name="id" type="UUID">
                <constraints primaryKey="true" primaryKeyName="pk_idempotency_records" nullable="false"/>
            </column>
            <column name="tenant_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_idempotency_records_tenant"
                             references="tenants(id)"
                             deleteCascade="false"/>
            </column>
            <column name="idempotency_key" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="endpoint" type="VARCHAR(160)">
                <constraints nullable="false"/>
            </column>
            <column name="request_hash" type="CHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="response_status" type="INTEGER"/>
            <column name="response_body" type="JSONB"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="idempotency_records"
                             columnNames="tenant_id, idempotency_key, endpoint"
                             constraintName="uq_idempotency_tenant_key_ep"/>

        <createIndex tableName="idempotency_records" indexName="idx_idempotency_expires">
            <column name="expires_at"/>
        </createIndex>

        <sql dbms="postgresql">
            ALTER TABLE idempotency_records
            ADD CONSTRAINT chk_idempotency_status
            CHECK (status IN ('IN_PROGRESS', 'COMPLETED', 'FAILED'));

            ALTER TABLE idempotency_records
            ADD CONSTRAINT chk_idempotency_key_not_blank
            CHECK (BTRIM(idempotency_key) &lt;&gt; '');
        </sql>

        <rollback>
            <dropTable tableName="idempotency_records"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
