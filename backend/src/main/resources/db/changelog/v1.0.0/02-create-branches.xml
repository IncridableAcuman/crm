<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="v1.0.0-02-create-branches" author="savdocrm-core">
        <comment>Create branches table with tenant ownership and composite constraints</comment>
        <createTable tableName="branches">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_branches_tenant"
                             references="tenants(id)"
                             deleteCascade="true"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="address" type="TEXT"/>
            <column name="phone" type="VARCHAR(30)"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="is_main" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="UUID"/>
            <column name="updated_by" type="UUID"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="branches"
                             columnNames="tenant_id, code"
                             constraintName="uq_branches_tenant_code"/>

        <addUniqueConstraint tableName="branches"
                             columnNames="tenant_id, id"
                             constraintName="uq_branches_tenant_id"/>

        <createIndex tableName="branches" indexName="idx_branches_tenant">
            <column name="tenant_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="branches"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
