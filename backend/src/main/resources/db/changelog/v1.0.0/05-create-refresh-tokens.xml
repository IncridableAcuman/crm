<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="v1.0.0-05-create-refresh-tokens" author="savdocrm-core">
        <comment>Create refresh_tokens table with token hashing, rotation family, and revocation support</comment>
        <createTable tableName="refresh_tokens">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_refresh_tokens_user"
                             references="users(id)"
                             deleteCascade="true"/>
            </column>
            <column name="token_hash" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_refresh_tokens_hash"/>
            </column>
            <column name="token_family" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="UUID">
                <constraints foreignKeyName="fk_refresh_tokens_tenant"
                             references="tenants(id)"
                             deleteCascade="true"/>
            </column>
            <column name="revoked" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="revoked_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="revoked_reason" type="VARCHAR(100)"/>
            <column name="expires_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_ip" type="VARCHAR(50)"/>
            <column name="user_agent" type="TEXT"/>
        </createTable>

        <createIndex tableName="refresh_tokens" indexName="idx_refresh_tokens_user">
            <column name="user_id"/>
        </createIndex>

        <createIndex tableName="refresh_tokens" indexName="idx_refresh_tokens_family">
            <column name="token_family"/>
        </createIndex>

        <createIndex tableName="refresh_tokens" indexName="idx_refresh_tokens_hash">
            <column name="token_hash"/>
        </createIndex>

        <rollback>
            <dropTable tableName="refresh_tokens"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
