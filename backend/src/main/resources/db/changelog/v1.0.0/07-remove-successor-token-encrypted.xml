<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="v1.0.0-07-remove-successor-token-encrypted" author="savdocrm-security">
        <comment>Remove obsolete encrypted successor token column for strict single-use rotation while preserving successor_token_hash for audit</comment>
        <dropColumn tableName="refresh_tokens" columnName="successor_token_encrypted"/>

        <rollback>
            <addColumn tableName="refresh_tokens">
                <column name="successor_token_encrypted" type="TEXT">
                    <constraints nullable="true"/>
                </column>
            </addColumn>
        </rollback>
    </changeSet>

</databaseChangeLog>
