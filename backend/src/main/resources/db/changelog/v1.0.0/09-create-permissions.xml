<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="v1.0.0-09-create-permissions" author="savdocrm-security">
        <comment>Create permissions table for global system-defined capabilities catalog</comment>
        <createTable tableName="permissions">
            <column name="id" type="UUID">
                <constraints primaryKey="true" primaryKeyName="pk_permissions" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(150)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_permissions_code"/>
            </column>
            <column name="module" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="resource" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE permissions
            ADD CONSTRAINT chk_permissions_code_format
            CHECK (code = (module || '.' || resource || '.' || action));
        </sql>

        <createIndex tableName="permissions" indexName="idx_permissions_module">
            <column name="module"/>
        </createIndex>

        <createIndex tableName="permissions" indexName="idx_permissions_resource">
            <column name="resource"/>
        </createIndex>

        <createIndex tableName="permissions" indexName="idx_permissions_mod_res">
            <column name="module"/>
            <column name="resource"/>
        </createIndex>

        <rollback>
            <dropTable tableName="permissions"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
